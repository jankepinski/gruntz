{
  "name": "gruntz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @gruntz/client --filter @gruntz/server dev",
    "dev:client": "pnpm --filter @gruntz/client dev",
    "dev:server": "pnpm --filter @gruntz/server dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "assets": "node assets/build-assets.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.3",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
